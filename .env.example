# Absolute site URL used for canonical links, hreflang, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://irasco.vercel.app

# Contact form delivery through Resend (https://resend.com).
# Without these the form shows a "send on WhatsApp instead" message.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "IRASCO Website <enquiries@irasco.in>"
ENQUIRY_FROM_EMAIL=
# Where enquiries are delivered. Defaults to irascoindia@gmail.com.
ENQUIRY_TO_EMAIL=
